<Window x:Class="CampusAP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:CampusAP.Core.Hotspot;assembly=CampusAP.Core"
        xmlns:ca="clr-namespace:CampusAP.Core.CampusAuth;assembly=CampusAP.Core"
        xmlns:controls="clr-namespace:CampusAP.App.Controls"
        Title="CampusAP · 校园热点助手"
        Height="950" Width="980"
        MinWidth="820" MinHeight="840"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Window.Resources>
        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Brush.InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.StateIdle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.On}">
                    <Setter Property="Fill" Value="#22C55E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Starting}">
                    <Setter Property="Fill" Value="#F59E0B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Error}">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Unsupported}">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 校园网认证状态点 -->
        <Style x:Key="AuthDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.StateIdle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuthState}" Value="{x:Static ca:CampusAuthState.Online}">
                    <Setter Property="Fill" Value="#3B82F6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuthState}" Value="{x:Static ca:CampusAuthState.NeedLogin}">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuthState}" Value="{x:Static ca:CampusAuthState.PortalHijack}">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuthState}" Value="{x:Static ca:CampusAuthState.NoInternet}">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 大开关按钮：随状态变色 -->
        <Style x:Key="ToggleButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="54"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.On}">
                    <Setter Property="Background" Value="#DC2626"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Starting}">
                    <Setter Property="Background" Value="#94A3B8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Unsupported}">
                    <Setter Property="Background" Value="#94A3B8"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="CampusAP" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="校园网热点 · 认证助手 · 设备管理" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：热点控制 + 诊断 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource StateDot}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0"
                                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Row="1" Style="{StaticResource ToggleButton}"
                                    Content="{Binding ToggleText}"
                                    Command="{Binding ToggleCommand}"
                                    Margin="0,14,0,0"/>

                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="热点名称" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <TextBlock Text="{Binding Ssid}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               ToolTip="{Binding Ssid}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="已连接设备" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ClientCount}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        <TextBlock Text=" 台" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <TextBlock Text="{Binding Password}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               ToolTip="{Binding Password}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 二维码 -->
                            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                                <Image Source="{Binding QrImage}" Width="170" Height="170" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock Text="手机扫码即可连接热点" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="能力检测与诊断" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding DiagnosisText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextBody}" LineHeight="20"/>
                            <TextBlock Text="{Binding NetworkEnvText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11.5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右：热点配置 + 校园网认证 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="热点配置" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="热点名称（SSID，≤32 字符）" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBox Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"/>
                            <TextBlock Text="密码（WPA2，至少 8 位）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" MaxLength="63"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="频段" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <ComboBox SelectedIndex="{Binding BandIndex}" Height="34" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="自动"/>
                                        <ComboBoxItem Content="2.4 GHz（兼容性好）"/>
                                        <ComboBoxItem Content="5 GHz（快，部分手机不支持）"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="1" Content="应用配置" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyConfigCommand}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="校园网认证" Style="{StaticResource CardTitle}" Margin="0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Style="{StaticResource AuthDot}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AuthStatusText}" Margin="8,0,8,0" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding AuthStatusText}"/>
                                <CheckBox Grid.Column="2" Content="掉线自动重登" IsChecked="{Binding CampusAutoRelogin}"
                                          VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </Grid>
                            <Grid Margin="0,6,0,0" IsEnabled="{Binding AuthFormEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="校园网账号" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CampusUserId, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CampusPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0" IsEnabled="{Binding AuthFormEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="运营商服务（不确定就留空）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CampusService, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="登录" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding LoginCampusCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="保存账号" Style="{StaticResource PrimaryButton}"
                                        Background="{DynamicResource Brush.AccentAlt}" Command="{Binding SaveCampusAccountCommand}"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                            <TextBlock Text="门户地址由网关重定向自动获取，无需配置；密码经 DPAPI 加密后仅存本机。"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 设备与流量 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" MaxHeight="260">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="设备与流量" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Bottom"/>
                        <TextBlock Text="双击设备名可自定义命名" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="{Binding TtlSpoofText}" IsChecked="{Binding TtlSpoof}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                                  Foreground="{DynamicResource Brush.TextSecondary}" ToolTip="把手机上行包TTL统一为与Windows一致，避免被网关识别多设备"/>
                        <CheckBox Content="夜间" IsChecked="{Binding DarkMode}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                                  Foreground="{DynamicResource Brush.TextSecondary}" ToolTip="夜间模式（深色主题）"/>
                        <Button Content="日志" Click="OpenLog_Click" Cursor="Hand" Padding="10,4"
                                BorderThickness="0" Foreground="White" FontWeight="SemiBold"
                                VerticalAlignment="Center" Margin="0,0,8,0"
                                ToolTip="实时诊断日志（引擎心跳/丢包统计/异常）"/>
                        <Button Content="{Binding FloatToggleText}"
                                Command="{Binding ToggleFloatWindowCommand}" Cursor="Hand"
                                Padding="10,4" BorderThickness="0" Foreground="White" FontWeight="SemiBold"
                                VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource Brush.AccentAlt}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FloatWindowOpen}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.BtnGray}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
                <controls:DevicePanel Grid.Row="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
