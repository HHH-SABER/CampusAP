<Window x:Class="CampusAP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:CampusAP.Core.Hotspot;assembly=CampusAP.Core"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="CampusAP · 校园热点助手"
        Height="680" Width="980"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="#F1F5F9"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Window.Resources>
        <!-- 系统托盘图标：右键菜单（显示/退出），左键恢复窗口 -->
        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="/Assets/app.ico"
                        ToolTipText="CampusAP · 校园热点助手"
                        Visibility="Collapsed"
                        TrayLeftMouseDown="TrayIcon_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示主窗口" FontWeight="SemiBold" Click="TrayShow_Click"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="#94A3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.On}">
                    <Setter Property="Fill" Value="#22C55E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Starting}">
                    <Setter Property="Fill" Value="#F59E0B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Error}">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Unsupported}">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 大开关按钮：随状态变色 -->
        <Style x:Key="ToggleButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="54"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.On}">
                    <Setter Property="Background" Value="#DC2626"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Starting}">
                    <Setter Property="Background" Value="#94A3B8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:HotspotState.Unsupported}">
                    <Setter Property="Background" Value="#94A3B8"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="CampusAP" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="校园网热点 · 认证助手 · 设备管理" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：热点控制 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource StateDot}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Row="1" Style="{StaticResource ToggleButton}"
                            Content="{Binding ToggleText}"
                            Command="{Binding ToggleCommand}"
                            Margin="0,14,0,0"/>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="热点名称" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock Text="{Binding Ssid}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Ssid}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="已连接设备" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ClientCount}" FontWeight="SemiBold"/>
                                <TextBlock Text=" 台"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock Text="{Binding Password}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Password}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 二维码 -->
                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                        <Image Source="{Binding QrImage}" Width="170" Height="170" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock Text="手机扫码即可连接热点" Foreground="#64748B" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：配置 + 诊断 -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="热点配置" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="热点名称（SSID，≤32 字符）" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBox Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"/>
                        <TextBlock Text="密码（WPA2，至少 8 位）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" MaxLength="63"/>
                        <TextBlock Text="频段" Style="{StaticResource FieldLabel}"/>
                        <ComboBox SelectedIndex="{Binding BandIndex}" Height="34">
                            <ComboBoxItem Content="自动"/>
                            <ComboBoxItem Content="2.4 GHz（兼容性好）"/>
                            <ComboBoxItem Content="5 GHz（快，部分手机不支持）"/>
                        </ComboBox>
                        <Button Content="应用配置" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyConfigCommand}" Margin="0,14,0,0"
                                HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="能力检测与诊断" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding DiagnosisText}" TextWrapping="Wrap"
                                   Foreground="#334155" LineHeight="20"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
