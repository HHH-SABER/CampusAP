<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题（默认）。所有界面颜色引用这里的键，切换主题即换字典。 -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.DialogBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.DialogBgAlt" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.TextBody" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#64748B"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.AccentAlt" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="Brush.BtnGray" Color="#64748B"/>
    <SolidColorBrush x:Key="Brush.FloatBg" Color="#FBFDFF"/>
    <SolidColorBrush x:Key="Brush.FloatBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.RateDown" Color="#16A34A"/>
    <SolidColorBrush x:Key="Brush.RateUp" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.StateIdle" Color="#94A3B8"/>
</ResourceDictionary>
