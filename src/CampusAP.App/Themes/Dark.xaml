    <SolidColorBrush x:Key="Brush.InputBorder" Color="#33415E"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#223049"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.AccentAlt" Color="#38BDF8"/>
