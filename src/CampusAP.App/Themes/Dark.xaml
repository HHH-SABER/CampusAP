    <SolidColorBrush x:Key="Brush.Card" Color="#141E30"/>
    <SolidColorBrush x:Key="Brush.DialogBg" Color="#141E30"/>
    <SolidColorBrush x:Key="Brush.DialogBgAlt" Color="#141E30"/>
