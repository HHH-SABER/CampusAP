<UserControl x:Class="CampusAP.App.Controls.DevicePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 引擎状态行 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#94A3B8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EngineRunning}" Value="True">
                                    <Setter Property="Fill" Value="#22C55E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding EngineStatusText}" Margin="7,0,0,0"
                           Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ToggleControlCommand}" Cursor="Hand"
                    Padding="10,4" BorderThickness="0" Foreground="White" FontWeight="SemiBold">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2563EB"/>
                        <Setter Property="Content" Value="开启管控"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EngineRunning}" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                                <Setter Property="Content" Value="停止管控"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- 设备列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="2,7,2,7" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="0.85*"/>
                                    <ColumnDefinition Width="0.85*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Background="Transparent"
                                            MouseLeftButtonDown="DeviceName_LeftButtonDown"
                                            ToolTipService.ShowDuration="8000"
                                            ToolTip="双击可修改设备名称">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#0F172A"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Mac}" Foreground="#94A3B8" FontSize="10.5"/>
                                    <TextBlock Text="{Binding Ip, StringFormat=IP：{0}}" Foreground="#94A3B8" FontSize="10.5"
                                               Visibility="{Binding IpLineVisibility}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Foreground="#16A34A" Text="{Binding DownRate}" ToolTip="下行速率"/>
                                    <TextBlock Foreground="#DC2626" Text="{Binding UpRate}" ToolTip="上行速率"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding TotalText}" VerticalAlignment="Center"
                                           Foreground="#64748B" Margin="4,0" TextTrimming="CharacterEllipsis"/>

                                <ComboBox Grid.Column="3" SelectedIndex="{Binding LimitIndex}" Margin="4,0"
                                          VerticalContentAlignment="Center" FontSize="11"
                                          IsEnabled="{Binding DataContext.EngineRunning, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ComboBoxItem Content="不限速"/>
                                    <ComboBoxItem Content="≤20 Mbps"/>
                                    <ComboBoxItem Content="≤5 Mbps"/>
                                    <ComboBoxItem Content="≤1 Mbps"/>
                                    <ComboBoxItem Content="≤256 Kbps"/>
                                </ComboBox>

                                <Button Grid.Column="4" Content="{Binding BlockText}" Margin="4,0,0,0"
                                        Command="{Binding BlockCommand}" Cursor="Hand"
                                        Padding="8,3" FontSize="11" BorderThickness="0" Foreground="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Blocked}" Value="True">
                                                    <Setter Property="Background" Value="#16A34A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
