<Window x:Class="CampusAP.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusAP 诊断日志（实时）" Height="520" Width="920"
        WindowStartupLocation="CenterScreen" Background="#0F172A">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,6">
            <Button Content="打开日志文件夹" Padding="10,4" Click="OpenFolder_Click" Cursor="Hand"/>
            <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True" Margin="14,0,0,0"
                      Foreground="#CBD5E1" VerticalAlignment="Center"/>
            <TextBlock Text="热路径不记录逐包日志；统计心跳 30 秒一条" Foreground="#64748B"
                       VerticalAlignment="Center" Margin="18,0,0,0" FontSize="11"/>
        </StackPanel>
        <TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Background="#0F172A" Foreground="#94A3B8" BorderThickness="0"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" TextChanged="LogText_TextChanged"/>
    </DockPanel>
</Window>
