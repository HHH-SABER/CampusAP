<Window x:Class="CampusAP.App.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CampusAP.App.Controls"
        Title="CampusAP 设备流量"
        Width="430" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Microsoft YaHei UI" FontSize="12">
    <Border Background="#FBFDFF" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Opacity="0.97">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <Grid Margin="14,10,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 可拖动标题条 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_LeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="设备流量" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                    <TextBlock Text="（拖动移动 · 置顶显示）" Foreground="#94A3B8" FontSize="10.5"
                               VerticalAlignment="Center" Margin="8,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Cursor="Hand"
                        Width="24" Height="24" BorderThickness="0" Background="Transparent"
                        Foreground="#64748B" FontSize="12"/>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10,6,10,8" Margin="0,8,0,0">
                <controls:DevicePanel/>
            </Border>
        </Grid>
    </Border>
</Window>
